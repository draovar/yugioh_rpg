{
  "name": "yugioh-rpg",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "node tools/patch-ocgcore.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-data": "node tools/data/fetch-data.mjs",
    "build-data": "node tools/data/build-data.mjs",
    "check-cards": "node tools/data/check-cards.mjs",
    "smoke": "node tools/test/smoke-duel.ts",
    "smoke-p2p": "node tools/test/smoke-p2p.ts",
    "arena": "node tools/ai/arena.ts",
    "test-ai": "node tools/ai/test-ai.ts",
    "tune": "node tools/ai/tune.ts",
    "ai-bench": "node tools/ai/ai-bench.ts",
    "fetch-art": "node tools/art/fetch-art.mjs",
    "build-fonts": "node tools/art/build-pixel-font.mjs public/assets/fonts/3x3_font_for_nerds.ttf nerds3 228.3 && node tools/art/build-tiny5-font.mjs",
    "build-art": "node tools/art/build-art.mjs",
    "build-palette": "node tools/art/build-palette.mjs",
    "build-tiles": "node tools/maps/build-tiles.mjs",
    "build-characters": "node tools/art/build-characters.mjs && node tools/art/build-ambush.mjs"
  },
  "dependencies": {
    "ocgcore-wasm": "^0.1.2",
    "peerjs": "^1.5.4",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
